# This Fastfile is largely based on
# https://medium.com/revelo-tech/setting-up-automatic-ios-release-with-fastlane-and-match-on-ci-cd-server-16c3f1d79bc5

require "plist"
require "shellwords"
require "tmpdir"
require "yaml"

platform :ios do
  bundle_id = "dev.shorebird.fastlane-demo"

  desc "Get certificates"
  lane :certificates do
    sync_code_signing(
      type: "development",
      app_identifier: bundle_id,
      readonly: true
    )
    sync_appstore_signing
  end

  desc "Generate new certificates"
  lane :generate_new_certificates do
    sync_code_signing(
      type: "development",
      app_identifier: bundle_id,
      force_for_new_devices: true,
      readonly: false
    )
    sync_code_signing(
      type: "appstore",
      app_identifier: bundle_id,
      readonly: false
    )
  end

  desc "create new release with shorebird"
  lane :release_shorebird do
    setup_ci
    # Load the API key first so missing credentials fail before anything is
    # built or released.
    app_store_connect_api_key(
      is_key_content_base64: true,
      in_house: false, # if it is enterprise or not
    )
    sync_appstore_signing
    # Each upload of a version needs a new build number, so continue from the
    # latest TestFlight build of the version in pubspec.yaml.
    pubspec = YAML.load_file(File.expand_path("../../pubspec.yaml", __dir__))
    version = pubspec["version"].split("+").first
    build_number = latest_testflight_build_number(
      app_identifier: bundle_id,
      version: version,
      initial_build_number: 0
    ) + 1
    # This step replaces the build_app step
    shorebird_release(
      platform: "ios",
      args: "--build-number=#{build_number}"
    )
    upload_to_app_store(
      app_identifier: bundle_id,
      # Upload the binary only: this sample has no store metadata or
      # screenshots, and CI can't confirm the HTML preview.
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false
    )
  end

  desc "patch with shorebird"
  lane :patch_shorebird do
    setup_ci
    sync_appstore_signing
    # shorebird_patch doesn't generate export options the way
    # shorebird_release does, so write them from the match profiles here.
    export_options = {
      method: "app-store",
      signingStyle: "manual",
      provisioningProfiles: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING],
      # Xcode must not change the build number, or the patch won't match its
      # release.
      manageAppVersionAndBuildNumber: false
    }
    export_options_plist = File.join(Dir.mktmpdir("shorebird"), "ExportOptions.plist")
    File.write(export_options_plist, export_options.to_plist)
    shorebird_patch(
      platform: "ios",
      args: "--release-version=latest --export-options-plist=#{Shellwords.escape(export_options_plist)}"
    )
  end

  private_lane :sync_appstore_signing do
    sync_code_signing(
      type: "appstore",
      app_identifier: bundle_id,
      readonly: true
    )
  end
end
