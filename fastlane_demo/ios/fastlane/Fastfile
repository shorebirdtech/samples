# This Fastfile is largely based on
# https://medium.com/revelo-tech/setting-up-automatic-ios-release-with-fastlane-and-match-on-ci-cd-server-16c3f1d79bc5

require "fileutils"
require "json"
require "shellwords"
require "tmpdir"
require "yaml"

# Don't regenerate fastlane/README.md on every run; the lanes are described in
# the sample's README.
skip_docs

platform :ios do
  bundle_id = "dev.shorebird.fastlane-demo"
  project_root = File.expand_path("../..", __dir__)
  # Xcode 15.3+ name for App Store distribution (formerly "app-store").
  export_method = "app-store-connect"

  # Every Shorebird release of the app, on any platform, as the hashes
  # `shorebird releases list --json` prints (`version`, `platform_statuses`,
  # `updated_at`, ...).
  shorebird_releases = lambda do
    # The command prints one line of JSON, which also explains any failure, so
    # read it instead of letting `sh` fail on the exit status. Progress and
    # notices come out around it. Like the plugin's commands, it runs from
    # ios/ and finds the project above it. It needs Shorebird credentials
    # (`shorebird login`, or SHOREBIRD_TOKEN on CI).
    output = sh(
      "shorebird releases list --json",
      log: false,
      error_callback: ->(_output) {}
    ).to_s
    json_line = output.lines.reverse.find { |line| line.lstrip.start_with?("{") }
    result = begin
      JSON.parse(json_line.to_s)
    rescue JSON::ParserError
      # No JSON at all, e.g. shorebird isn't installed or is too old.
      UI.user_error!("Couldn't list Shorebird releases (is a current shorebird CLI installed?):\n#{output}")
    end
    unless result["status"] == "success"
      UI.user_error!("Couldn't list Shorebird releases: #{result.dig('error', 'message')}\n#{output}")
    end
    releases = Array(result.dig("data", "releases"))
    unless releases.all? { |release| release.is_a?(Hash) && release["version"].is_a?(String) }
      UI.user_error!("Unexpected releases from shorebird releases list: #{releases.inspect}")
    end
    releases
  end

  # The highest build number Shorebird has a release for in this version, or
  # 0 if there is none. Release versions are shared across platforms, so
  # releases for any platform count.
  latest_shorebird_build_number = lambda do |version|
    # to_i takes the leading number of a dotted build number such as 12.1.
    shorebird_releases.call
      .map { |release| release["version"] }
      .select { |release_version| release_version.start_with?("#{version}+") }
      .map { |release_version| release_version.split("+", 2).last.to_i }
      .max || 0
  end

  desc "Get certificates"
  lane :certificates do
    sync_code_signing(
      type: "development",
      app_identifier: bundle_id,
      readonly: true
    )
    sync_appstore_signing
  end

  desc "Generate new certificates"
  lane :generate_new_certificates do
    sync_code_signing(
      type: "development",
      app_identifier: bundle_id,
      force_for_new_devices: true,
      readonly: false
    )
    sync_code_signing(
      type: "appstore",
      app_identifier: bundle_id,
      readonly: false
    )
  end

  desc "create new release with shorebird"
  lane :release_shorebird do
    setup_ci
    # On CI, load the API key first so missing credentials fail before
    # anything is built or released. Locally, without the key, fastlane uses
    # your Apple ID login instead.
    if FastlaneCore::Helper.ci? || !ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"].to_s.empty?
      app_store_connect_api_key(
        is_key_content_base64: true,
        in_house: false, # if it is enterprise or not
      )
    end
    sync_appstore_signing
    # Each release of a version needs a new build number: one past both the
    # latest TestFlight build and the latest Shorebird release of the pubspec
    # version (a release whose upload failed is only in Shorebird), and never
    # lower than the pubspec's own.
    pubspec_version = YAML.load_file(File.join(project_root, "pubspec.yaml"))["version"]
    UI.user_error!("pubspec.yaml has no version, e.g. `version: 1.0.0+1`") unless pubspec_version
    version, pubspec_build_number = pubspec_version.to_s.split("+")
    build_number = [
      # to_i because App Store Connect can report build numbers as strings.
      latest_testflight_build_number(
        app_identifier: bundle_id,
        version: version,
        initial_build_number: 0
      ).to_i + 1,
      latest_shorebird_build_number.call(version) + 1,
      pubspec_build_number.to_i
    ].max
    # This step replaces the build_app step
    # The plugin writes its export options plist (which names the
    # provisioning profiles) under Dir.tmpdir and doesn't say where, so point
    # TMPDIR at a directory of our own for the release and remove it after.
    release_tmpdir = Dir.mktmpdir("fastlane_demo")
    original_tmpdir = ENV.fetch("TMPDIR", nil)
    ENV["TMPDIR"] = release_tmpdir
    begin
      shorebird_release(
        platform: "ios",
        args: "--build-number=#{build_number}",
        export_options: { method: export_method }
      )
    ensure
      ENV["TMPDIR"] = original_tmpdir
      FileUtils.rm_rf(release_tmpdir)
    end
    # Upload the binary to TestFlight. Submitting it to the App Store is left
    # to App Store Connect, since this sample has no store metadata.
    upload_to_testflight(
      app_identifier: bundle_id,
      skip_waiting_for_build_processing: true
    )
  end

  desc "patch with shorebird (release_version: the release to patch, e.g. 1.0.0+11)"
  lane :patch_shorebird do |options|
    # Name the release to patch, normally the one in the App Store, so a
    # release that never shipped can't be patched by default. `latest` (the
    # most recently updated iOS release) also works.
    release_version = options[:release_version].to_s.strip
    if release_version.empty?
      UI.user_error!("Pass the release to patch, e.g. `fastlane ios patch_shorebird release_version:1.0.0+11`")
    end
    if release_version == "latest"
      latest = shorebird_releases.call
               .select { |release| release.fetch("platform_statuses", {}).key?("ios") }
               .max_by { |release| release["updated_at"].to_s }
      UI.user_error!("Shorebird has no iOS release to patch") unless latest
      release_version = latest["version"]
    end
    build_name, build_number = release_version.split("+", 2)
    unless build_number
      UI.user_error!("release_version must look like 1.0.0+11, got #{release_version}")
    end
    setup_ci
    sync_appstore_signing
    # shorebird_patch doesn't generate export options the way
    # shorebird_release does, so use the plugin's helper for the same plist:
    # the match profiles with manual signing, and Xcode kept from changing the
    # build number.
    export_options_plist = Fastlane::Helper::ExportOptionsPlist.generate_export_options_plist(
      { method: export_method },
      lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    )
    begin
      # Build the patch with the release's own version and build number, not
      # the pubspec's. shorebird patch doesn't do this itself when given only
      # --release-version.
      shorebird_patch(
        platform: "ios",
        args: [
          "--release-version=#{Shellwords.escape(release_version)}",
          "--build-name=#{Shellwords.escape(build_name)}",
          "--build-number=#{Shellwords.escape(build_number)}",
          "--export-options-plist=#{Shellwords.escape(export_options_plist)}"
        ].join(" ")
      )
    ensure
      # The helper writes the plist, which names the provisioning profiles, to
      # a new temporary directory.
      FileUtils.rm_rf(File.dirname(export_options_plist))
    end
  end

  private_lane :sync_appstore_signing do
    sync_code_signing(
      type: "appstore",
      app_identifier: bundle_id,
      readonly: true
    )
  end
end
