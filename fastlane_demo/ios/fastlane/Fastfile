# This Fastfile is largely based on
# https://medium.com/revelo-tech/setting-up-automatic-ios-release-with-fastlane-and-match-on-ci-cd-server-16c3f1d79bc5

require "json"
require "plist"
require "shellwords"
require "tmpdir"
require "yaml"

PROJECT_ROOT = File.expand_path("../..", __dir__)

# The highest iOS build number Shorebird has a release for in this version, or
# 0 if there is none.
def latest_shorebird_build_number(version)
  # Progress goes to stderr and stdout is a JSON result, which also explains
  # any failure, so read it instead of letting `sh` fail on the exit status.
  output = sh(
    "cd #{Shellwords.escape(PROJECT_ROOT)} && shorebird releases list --platform=ios --json 2>/dev/null",
    log: false,
    error_callback: ->(_output) {}
  )
  # The dry run in CI stubs `sh` and gets no output.
  return 0 if output.to_s.empty?

  result = begin
    JSON.parse(output)
  rescue JSON::ParserError
    UI.user_error!("Couldn't list Shorebird releases: #{output}")
  end
  unless result["status"] == "success"
    UI.user_error!("Couldn't list Shorebird releases: #{result.dig('error', 'message')}")
  end
  result.dig("data", "releases")
    .map { |release| release["version"].to_s }
    .select { |release_version| release_version.start_with?("#{version}+") }
    .map { |release_version| release_version.split("+").last.to_i }
    .max || 0
end

# Xcode 15.3+ name for App Store distribution (formerly "app-store").
EXPORT_METHOD = "app-store-connect"

platform :ios do
  bundle_id = "dev.shorebird.fastlane-demo"

  desc "Get certificates"
  lane :certificates do
    sync_code_signing(
      type: "development",
      app_identifier: bundle_id,
      readonly: true
    )
    sync_appstore_signing
  end

  desc "Generate new certificates"
  lane :generate_new_certificates do
    sync_code_signing(
      type: "development",
      app_identifier: bundle_id,
      force_for_new_devices: true,
      readonly: false
    )
    sync_code_signing(
      type: "appstore",
      app_identifier: bundle_id,
      readonly: false
    )
  end

  desc "create new release with shorebird (build_number: defaults to the next free one)"
  lane :release_shorebird do |options|
    setup_ci
    # Load the API key first so missing credentials fail before anything is
    # built or released.
    app_store_connect_api_key(
      is_key_content_base64: true,
      in_house: false, # if it is enterprise or not
    )
    sync_appstore_signing
    # Each release of a version needs a new build number: one past both the
    # latest TestFlight build and the latest Shorebird release of the pubspec
    # version (a release whose upload failed is only in Shorebird), and never
    # lower than the pubspec's own. Pass build_number: to choose it yourself.
    pubspec = YAML.load_file(File.join(PROJECT_ROOT, "pubspec.yaml"))
    version, pubspec_build_number = pubspec["version"].split("+")
    build_number = options[:build_number] || [
      # to_i because App Store Connect can report build numbers as strings.
      latest_testflight_build_number(
        app_identifier: bundle_id,
        version: version,
        initial_build_number: 0
      ).to_i + 1,
      latest_shorebird_build_number(version) + 1,
      pubspec_build_number.to_i
    ].max
    # This step replaces the build_app step
    shorebird_release(
      platform: "ios",
      args: "--build-number=#{build_number}",
      export_options: { method: EXPORT_METHOD }
    )
    # Upload the binary to TestFlight. Submitting it to the App Store is left
    # to App Store Connect, since this sample has no store metadata.
    upload_to_testflight(
      app_identifier: bundle_id,
      skip_waiting_for_build_processing: true
    )
  end

  desc "patch with shorebird (release_version: defaults to the latest release)"
  lane :patch_shorebird do |options|
    # Pass release_version:1.0.0+11 to patch a specific release, for example
    # the one in the App Store rather than the newest one created.
    release_version = options[:release_version] || "latest"
    setup_ci
    sync_appstore_signing
    # shorebird_patch doesn't generate export options the way
    # shorebird_release does, so write them from the match profiles here.
    export_options = {
      method: EXPORT_METHOD,
      # Xcode must not change the build number, or the patch won't match its
      # release.
      manageAppVersionAndBuildNumber: false
    }
    profiles = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    if profiles
      export_options[:provisioningProfiles] = profiles
      export_options[:signingStyle] = "manual"
    end
    Dir.mktmpdir("shorebird") do |dir|
      export_options_plist = File.join(dir, "ExportOptions.plist")
      File.write(export_options_plist, export_options.to_plist)
      shorebird_patch(
        platform: "ios",
        args: [
          "--release-version=#{Shellwords.escape(release_version)}",
          "--export-options-plist=#{Shellwords.escape(export_options_plist)}"
        ].join(" ")
      )
    end
  end

  private_lane :sync_appstore_signing do
    sync_code_signing(
      type: "appstore",
      app_identifier: bundle_id,
      readonly: true
    )
  end
end
