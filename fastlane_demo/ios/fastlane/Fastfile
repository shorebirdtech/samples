# This Fastfile is largely based on
# https://medium.com/revelo-tech/setting-up-automatic-ios-release-with-fastlane-and-match-on-ci-cd-server-16c3f1d79bc5

platform :ios do
  bundle_id = "dev.shorebird.fastlane-demo"

  desc "Get certificates"
  lane :certificates do
    sync_code_signing(
      type: "development",
      app_identifier: bundle_id,
      readonly: true
    )
    sync_appstore_signing
  end

  desc "Generate new certificates"
  lane :generate_new_certificates do
    sync_code_signing(
      type: "development",
      app_identifier: bundle_id,
      force_for_new_devices: true,
      readonly: false
    )
    sync_code_signing(
      type: "appstore",
      app_identifier: bundle_id,
      readonly: false
    )
  end

  desc "create new release with shorebird"
  lane :release_shorebird do
    setup_ci
    # Load the API key first so missing credentials fail before anything is
    # built or released.
    app_store_connect_api_key(
      is_key_content_base64: true,
      in_house: false, # if it is enterprise or not
    )
    sync_appstore_signing
    # Each App Store upload needs a new build number.
    build_number = latest_testflight_build_number(
      app_identifier: bundle_id,
      initial_build_number: 0
    ) + 1
    # This step replaces the build_app step
    shorebird_release(
      platform: "ios",
      args: "--build-number=#{build_number}"
    )
    upload_to_app_store(
      app_identifier: bundle_id,
      force: false,
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
  end

  desc "patch with shorebird"
  lane :patch_shorebird do
    setup_ci
    sync_appstore_signing
    # shorebird_patch doesn't generate export options the way
    # shorebird_release does, so build them from the match profiles here.
    export_options_plist = Fastlane::Helper::ExportOptionsPlist.generate_export_options_plist(
      {},
      lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    )
    shorebird_patch(
      platform: "ios",
      args: "--release-version=latest --export-options-plist=#{export_options_plist}"
    )
  end

  private_lane :sync_appstore_signing do
    sync_code_signing(
      type: "appstore",
      app_identifier: bundle_id,
      readonly: true
    )
  end
end
